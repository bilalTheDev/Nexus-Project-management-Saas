DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
# Separate from DJANGO_SECRET_KEY so JWT and Django secrets rotate independently.
JWT_SIGNING_KEY=replace-me-with-a-different-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Never True in production — exposes password-reset tokens in JSON for local tests only.
ALLOW_PASSWORD_RESET_DEBUG=False
# Optional override: Lax | None (default: Lax when DEBUG, None when not)
# JWT_REFRESH_COOKIE_SAMESITE=

# Postgres / Neon — set in backend/.env (never commit real values)
# Prefer pooled URL for the app; unpooled/direct URL for migrations
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
# Keep True when the host requires SSL (Neon does)
DATABASE_SSL_REQUIRE=True
# Pooler-compatible: 0 for transaction pooler; 60–600 for session/direct (health checks auto-on when >0)
# DATABASE_CONN_MAX_AGE=0

# Upload body cap (bytes); default 2 MiB
# DATA_UPLOAD_MAX_MEMORY_SIZE=2097152

# Production HTTPS (applied automatically when DJANGO_DEBUG=False)
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_PRELOAD=False
# Enable ONLY on PythonAnywhere / proxies that strip client X-Forwarded-Proto:
# SECURE_PROXY_SSL_HEADER_ENABLED=True

# Optional Sentry — leave empty to disable. Never commit a real DSN.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0.0

# Comma-separated exact origins (local Vite + production Vercel).
# Include BOTH localhost and 127.0.0.1 for local Vite — browsers treat them as different origins.
# Never use * with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional comma-separated regexes for Vercel preview deployments (NEX-128).
# Do NOT put secrets here — only public origin patterns.
# Example: ^https://nexus-.*\.vercel\.app$,^https://.*-bilalthedev\.vercel\.app$
CORS_ALLOWED_ORIGIN_REGEXES=

VITE_API_BASE_URL=http://localhost:8000/api/v1
